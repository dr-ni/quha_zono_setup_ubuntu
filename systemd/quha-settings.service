[Unit]
Description=Quha Zono Einstellungen setzen

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 1
# Werte hier anpassen, danach: sudo systemctl daemon-reload
ExecStart=/usr/local/bin/quha-settings speed 21 21
ExecStart=/usr/local/bin/quha-settings filter 1 2
ExecStart=/usr/local/bin/quha-settings doubleclick off
ExecStart=/usr/local/bin/quha-settings autoclick off
